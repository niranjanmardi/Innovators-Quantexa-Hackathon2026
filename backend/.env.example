# Database Configuration (for caching/storage if required later)
# DATABASE_URL=postgresql://user:password@localhost/quantdb
# REDIS_URL=redis://localhost:6379/0

# Market Data API Keys
# If using a paid provider, place your key here. Not needed for yfinance.
# MARKET_DATA_API_KEY=your_market_data_api_key_here

# NewsData.io API Key
NEWSDATA_API_KEY=your_newsdata_api_key_here
NEWS_CACHE_TTL_MINUTES=30
NEWS_MAX_ARTICLES=200
NEWS_DAILY_CREDIT_CAP=180

# Explainable AI API Key
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=gemini # e.g., gemini, openai
